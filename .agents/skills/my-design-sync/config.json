    "story": {"dir": "design/20-世界观与剧情", "role": "世界观、剧情、事件与叙事"},
    "character": {"dir": "design/30-角色设定", "role": "诗人、宠物、上贡者及关系"},
    "art_assets": {
      "dir": "design/40-美术素材",
      "index": "design/40-美术素材/素材索引.md",
      "role": "建模、场景、角色、道具与供品源资产"
    },
    "visual": {"dir": "design/50-视觉规范", "role": "视觉语言与设计 token"},
    "inbox": {"dir": "design/90-待整理", "role": "无法可靠分类的输入"},
    "deletion_review": {
      "dir": "design/99-待删除审核",
      "index": "design/99-待删除审核/待删除审核清单.md",
      "role": "等待用户确认的失效旧件"
    }
  },
  "dependency_graph": {
    "core": ["system", "story", "character", "art_assets", "visual"],
    "system": ["story", "character", "art_assets", "visual"],
    "story": ["character", "system", "art_assets", "visual"],
    "character": ["story", "system", "art_assets", "visual"],
    "art_assets": ["visual", "project_runtime_assets"],
    "visual": ["art_assets", "project_runtime_assets"],
    "legal_records": []
  },
  "records": {
    "progress": "记录/进度.md",
    "log": "记录/决策与活动日志.md",
    "sources": "记录/源文件索引.md"
  },
  "legal_dir": "法律文件",
  "runtime_asset_targets": ["project/public/assets", "project/src/assets"],
  "rules": [
    "AGENTS.md",
    "CLAUDE.md",
    "design/AGENTS.md",
    "design/CLAUDE.md",
    "project/AGENTS.md",
    "project/CLAUDE.md",
    "project/v1-archive/AGENTS.md",
    "project/v1-archive/CLAUDE.md"
  ],
  "retired_artifacts": {
    "deleted_on": "2026-07-30",
    "patterns": ["*.base", "*MAP.md"],
    "nested_design_rule_files_allowed": false,
    "active_design_navigation": "design/设计资料索引.md",
    "active_design_rules": ["design/AGENTS.md", "design/CLAUDE.md"],
    "historical_mentions_are_not_dependencies": true
  },
  "also_scan_root": ["PLAN.md", "写作方式说明.md", "主管使用说明.md"],
  "historical_exclusions": [
    "记录/决策与活动日志.md",
    "需求快照/",
    "design/99-待删除审核/",
    "project/v1-archive/",
    ".claude/plans/"
  ],
  "commit": {
    "convention": "type: english description",
    "annotated_tag_required": true,
    "push": "禁止自动 push，须用户确认",
    "parent_repo_warning": "flawed-ai 是独立仓库，不在父仓库 claude库 中 add"
  },
  "verification": {
    "risk_adaptive": true,
    "max_reviewers": 1,
    "max_targeted_recheck": 1,
    "stop_after_clean_round": true
  }
}
